{
  "name": "sourdough-calculator",
  "version": "1.0.0",
  "description": "Sourdough fermentation calculator with timer and schedule generation",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsc --watch & python3 -m http.server 8000",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "sourdough",
    "baking",
    "calculator",
    "fermentation",
    "typescript"
  ],
  "author": "Emelie Jomer",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^28.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
